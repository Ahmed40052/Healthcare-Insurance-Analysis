        "import pandas as pd\n",
        "\n",
        "# Load the cleaned dataset\n",
        "df = pd.read_csv('insurance_clean.csv')\n",
        "\n",
        "# Compute average BMI per region\n",
        "region_bmi = df.groupby('region')['bmi'].mean().round(2)\n",
        "print(region_bmi)"
